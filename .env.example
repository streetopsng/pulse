# Firebase Configuration for Pulse Survey
# Copy this file to .env and fill in your project credentials from the Firebase Console (Project Settings > General > Your apps)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Brevo (formerly Sendinblue) Transactional Email Configuration
# Server-side (Vercel Serverless Function):
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=surveys@yourdomain.com
BREVO_SENDER_NAME="Pulse Survey Team"

# Client-side (Optional for direct client testing):
VITE_BREVO_API_KEY=xkeysib-your_brevo_api_key_here
VITE_BREVO_SENDER_EMAIL=surveys@yourdomain.com
VITE_BREVO_SENDER_NAME="Pulse Survey Team"
